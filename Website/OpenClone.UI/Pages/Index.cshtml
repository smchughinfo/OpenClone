@page
@using Microsoft.AspNetCore.Authorization;
@model IndexModel
@{
    ViewData["Title"] = "Welcome to OpenClone";
}

<style>
    .hero-section {
        background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
        color: white;
        padding: 100px 0;
        margin: -20px -15px 40px -15px;
    }
    .feature-card {
        height: 100%;
    }
    .feature-icon {
        font-size: 3rem;
        color: #667eea;
        margin-bottom: 1rem;
    }
    .btn-get-started {
        background: linear-gradient(45deg, #667eea, #764ba2);
        border: 2px solid white;
        padding: 12px 30px;
        font-size: 1.1rem;
        border-radius: 50px;
        transition: all 0.3s ease;
        box-shadow: 0 4px 15px rgba(102, 126, 234, 0.2);
    }
    .btn-get-started:hover {
        transform: translateY(-3px);
        box-shadow: 0 12px 35px rgba(102, 126, 234, 0.5);
        border-color: white;
    }
    .stats-section {
        background-color: #f8f9fa;
        padding: 60px 0;
        margin: 60px -15px;
    }
    .stat-number {
        font-size: 2.5rem;
        font-weight: bold;
        color: #667eea;
    }
</style>

<!-- Hero Section -->
<div class="hero-section text-center">
    <div class="container">
        <h1 class="display-2 fw-bold mb-4">OpenClone Demo</h1>
        <p class="lead fs-4 mb-4">Create AI-powered digital clones that talk, think, and interact just like you</p>
        @if (User.Identity.IsAuthenticated)
        {
            <p class="fs-5">Experience the future of personal AI with lifelike avatars powered by cutting-edge deepfake technology</p>
        }
        else
        {
            <p class="fs-5 mb-5">Experience the future of personal AI with lifelike avatars powered by cutting-edge deepfake technology</p>
            <button type="button" class="btn btn-outline-light btn-lg me-3" data-bs-toggle="modal" data-bs-target="#videoModal">
                <i class="bi bi-play-circle"></i> Watch The Video
            </button>
            <a href="/Identity/Account/Register" class="btn btn-outline-light btn-lg">
                <i class="bi bi-rocket-takeoff"></i> Try It Out
            </a>
        }
    </div>
</div>

@if (!User.Identity.IsAuthenticated)
{
    <!-- Features Section -->
    <div class="container my-5">
        <div class="row text-center mb-5">
            <div class="col-lg-12 mx-auto">
                <h2 class="display-5 fw-bold mb-3">Open Source</h2>
                <p class="lead text-muted">Developer-friendly architecture with automated deployment. Go from <a href="https://github.com/smchughinfo/OpenClone" target="_blank" class="text-decoration-none">download</a> to production in minutes, not hours.</p>
            </div>
        </div>
        
        <div class="row g-4">
            <div class="col-md-4">
                <div class="card feature-card border-0 shadow-sm h-100">
                    <div class="card-body text-center p-4">
                        <i class="bi bi-diagram-3 feature-icon"></i>
                        <h4 class="fw-bold">Kubernetes Microservice Architecture</h4>
                        <p class="text-muted">Scalable containerized services including database, video generation, background removal, and web interface deployed with Terraform and Kubernetes orchestration.</p>
                    </div>
                </div>
            </div>
            
            <div class="col-md-4">
                <div class="card feature-card border-0 shadow-sm h-100">
                    <div class="card-body text-center p-4">
                        <i class="bi bi-code-slash feature-icon"></i>
                        <h4 class="fw-bold">.NET MVC/React Front End</h4>
                        <p class="text-muted">Modern web application built with ASP.NET Core MVC, React components, SignalR real-time communication, and Webpack bundling for optimal performance.</p>
                    </div>
                </div>
            </div>
            
            <div class="col-md-4">
                <div class="card feature-card border-0 shadow-sm h-100">
                    <div class="card-body text-center p-4">
                        <i class="bi bi-cpu feature-icon"></i>
                        <h4 class="fw-bold">AI Microservices</h4>
                        <p class="text-muted">Integrated AI services including SadTalker for deepfake video generation, OpenAI for conversational intelligence, and ElevenLabs for voice synthesis.</p>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Stats Section -->
    <div class="stats-section">
        <div class="container">
            <div class="row text-center">
                <div class="col-md-4">
                    <div class="stat-number"><i class="bi bi-cloud"></i></div>
                    <h5>Cloud Ready</h5>
                    <p class="text-muted">Automated deployment to Vultr's cloud</p>
                </div>
                <div class="col-md-4">
                    <div class="stat-number">∞</div>
                    <h5>Unlimited Potential</h5>
                    <p class="text-muted">Train your clone with unlimited Q&A sessions</p>
                </div>
                <div class="col-md-4">
                    <div class="stat-number"><i class="bi bi-shield-check"></i></div>
                    <h5>Privacy First</h5>
                    <p class="text-muted">Logs are optional and disabled by default</p>
                </div>
            </div>
        </div>
    </div>

    <!-- CTA Section -->
    <div class="container text-center my-5 py-5">
        <h2 class="display-6 fw-bold mb-3">Ready for Upload?</h2>
        <p class="lead text-muted mb-4">Try the demo system or fork the repository to deploy your own instance</p>
        <div class="d-flex justify-content-center gap-3 flex-wrap">
            <a href="/Identity/Account/Register" class="btn btn-outline-primary btn-lg">
                <i class="bi bi-person-plus"></i> Try Demo
            </a>
            <a href="https://github.com/smchughinfo/OpenClone" target="_blank" class="btn btn-outline-secondary btn-lg">
                <i class="bi bi-github"></i> View Source
            </a>
        </div>
    </div>

    <!-- Video Modal -->
    <div class="modal fade" id="videoModal" tabindex="-1" aria-labelledby="videoModalLabel" aria-hidden="true">
        <div class="modal-dialog modal-lg modal-dialog-centered">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title" id="videoModalLabel">OpenClone Demo</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body p-0">
                    <div class="ratio ratio-16x9">
                        <iframe src="https://www.youtube.com/embed/nDsLsFpFoxI" frameborder="0" allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture" allowfullscreen></iframe>
                    </div>
                </div>
            </div>
        </div>
    </div>
}
else
{
    <!-- Logged In User Dashboard Preview -->
    <div class="container my-5">
        <div class="row">
            <div class="col-lg-8 mx-auto text-center">
                <h2 class="display-6 fw-bold mb-3">Welcome back, @User.Identity.Name!</h2>
                <p class="lead text-muted mb-4">Continue building and training your AI clones</p>
                
                <div class="row g-3 justify-content-center">
                    <div class="col-sm-6 col-md-4">
                        <a href="/CloneManager" class="btn btn-outline-primary btn-lg w-100">
                            <i class="bi bi-person-gear d-block mb-2" style="font-size: 2rem;"></i>
                            Manage Clones
                        </a>
                    </div>
                    <div class="col-sm-6 col-md-4">
                        <a href="/QA" class="btn btn-outline-success btn-lg w-100 disabled" id="trainAiBtn">
                            <i class="bi bi-chat-square-quote d-block mb-2" style="font-size: 2rem;"></i>
                            Answer Questions
                        </a>
                    </div>
                    <div class="col-sm-6 col-md-4">
                        <a href="/ChatBot" class="btn btn-outline-info btn-lg w-100 disabled" id="chatNowBtn">
                            <i class="bi bi-chat-dots d-block mb-2" style="font-size: 2rem;"></i>
                            Chat Now
                        </a>
                    </div>
                </div>
            </div>
        </div>
    </div>
}

<script>
// One-off JavaScript for Index page - Get user's clones
document.addEventListener('DOMContentLoaded', function() {
    // Only run for authenticated users
    @if (User.Identity.IsAuthenticated)
    {
        <text>
        // Call GetClones API and dump to console
        fetch('/api/CloneCrud/GetClones', {
            method: 'GET',
            headers: {
                'Content-Type': 'application/json',
            },
            credentials: 'same-origin' // Include cookies for authentication
        })
        .then(response => {
            if (!response.ok) {
                throw new Error(`HTTP error! status: ${response.status}`);
            }
            return response.json();
        })
        .then(data => {
            console.log('User clones data:', data);
            
            // Enable buttons if user has clones
            if (data && data.length > 0) {
                const chatWithClonesBtn = document.getElementById('chatWithClonesBtn');
                const trainAiBtn = document.getElementById('trainAiBtn');
                const chatNowBtn = document.getElementById('chatNowBtn');
                
                if (chatWithClonesBtn) {
                    chatWithClonesBtn.classList.remove('disabled');
                }
                if (trainAiBtn) {
                    trainAiBtn.classList.remove('disabled');
                }
                if (chatNowBtn) {
                    chatNowBtn.classList.remove('disabled');
                }
            }
        })
        .catch(error => {
            console.error('Error fetching clones:', error);
        });
        </text>
    }
});
</script>
