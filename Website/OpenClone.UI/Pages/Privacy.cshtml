@page
@{
    ViewData["Title"] = "Privacy Policy";
}

<div class="container py-5">
    <div class="row justify-content-center">
        <div class="col-lg-8">
            <div class="card border-0 shadow-sm">
                <div class="card-body p-5">
                    <div class="text-center mb-5">
                        <h1 class="h2 mb-3">Privacy Policy</h1>
                        <p class="text-muted">Last updated: @DateTime.Now.ToString("MMMM dd, yyyy")</p>
                    </div>

                    <div class="mb-4">
                        <h3 class="h4 mb-3">Your Privacy Matters</h3>
                        <p>OpenClone is committed to protecting your privacy. This policy explains how we handle your information.</p>
                    </div>

                    <div class="mb-4">
                        <h3 class="h4 mb-3">Information We Collect</h3>
                        <ul>
                            <li><strong>Google Account Information:</strong> Email address for authentication purposes only</li>
                            <li><strong>Clone Data:</strong> The clones you create, including images, voice samples, and personality data</li>
                            <li><strong>Usage Data:</strong> How you interact with the service (conversations, features used, etc.)</li>
                        </ul>
                    </div>

                    <div class="mb-4">
                        <h3 class="h4 mb-3">How We Use Your Information</h3>
                        <ul>
                            <li>To make the service work (that's it, really)</li>
                        </ul>
                    </div>

                    <div class="mb-4">
                        <h3 class="h4 mb-3">Third-Party Services</h3>
                        <div class="alert alert-info">
                            <p class="mb-2">OpenClone integrates with external services to provide functionality:</p>
                            <ul class="mb-0">
                                <li><strong>Google:</strong> Authentication and sign-in</li>
                                <li><strong>OpenAI:</strong> AI conversation and content generation</li>
                                <li><strong>ElevenLabs:</strong> Voice synthesis and audio generation</li>
                            </ul>
                        </div>
                        <p><small class="text-muted">These services have their own privacy policies. We only share the minimum data necessary for functionality.</small></p>
                    </div>

                    <div class="mb-4">
                        <h3 class="h4 mb-3">Data Security</h3>
                        <p>We implement reasonable security measures to protect your data. However, no internet service is 100% secure. Use OpenClone at your own discretion.</p>
                    </div>

                    <div class="mb-4">
                        <h3 class="h4 mb-3">Data Retention</h3>
                        <p>We retain your data as long as your account is active. You can delete your account and associated data at any time through your account settings.</p>
                        <div class="alert alert-warning">
                            <small><strong>Note:</strong> Data may be deleted at any time due to server maintenance, storage limitations, or other operational needs.</small>
                        </div>
                    </div>

                    <div class="mb-4">
                        <h3 class="h4 mb-3">Your Rights</h3>
                        <ul>
                            <li>Access and download your data</li>
                            <li>Correct inaccurate information</li>
                            <li>Delete your account and data</li>
                        </ul>
                    </div>

                    <div class="mb-4">
                        <h3 class="h4 mb-3">Children's Privacy</h3>
                        <p>OpenClone is not intended for users under 13 years of age. We do not knowingly collect personal information from children under 13.</p>
                    </div>

                    <div class="mb-4">
                        <h3 class="h4 mb-3">International Users</h3>
                        <p>OpenClone may be hosted in various countries. By using the service, you consent to the transfer of your data to countries that may have different privacy laws.</p>
                    </div>

                    <div class="mb-4">
                        <h3 class="h4 mb-3">Changes to Privacy Policy</h3>
                        <p>We may update this privacy policy from time to time. We'll notify you of significant changes via email or through the service.</p>
                    </div>

                    <div class="text-center mt-5">
                        <a href="/" class="btn btn-primary">Back to OpenClone</a>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>